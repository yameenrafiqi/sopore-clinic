# Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# Backend API URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:5001/api

# OpenAI API Key (for AI Physiotherapy Assistant)
NEXT_PUBLIC_OPENAI_KEY=your_openai_api_key_here

# Google Maps API Key (optional)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_key_here

# JWT Secret (same as backend)
NEXT_PUBLIC_JWT_SECRET=your_jwt_secret_here
